rules_version = '2';

// Each user can only read and write their own reading sessions and
// bookmarks. No stats are stored on the server: every device derives them
// from sessions, so there is nothing authoritative for a client to forge.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validSession(sessionId) {
      let d = request.resource.data;
      let wallSeconds = (d.endedAt.toMillis() - d.startedAt.toMillis()) / 1000;
      return d.keys().hasOnly([
          'id', 'deviceId', 'startedAt', 'endedAt', 'activeSeconds',
          'timezone', 'localDate', 'mode', 'lastVerseKey', 'syncedAt'])
        && d.keys().hasAll([
          'id', 'deviceId', 'startedAt', 'endedAt', 'activeSeconds',
          'timezone', 'localDate', 'mode', 'syncedAt'])
        && d.id == sessionId
        && sessionId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')
        && d.deviceId is string && d.deviceId.size() > 0 && d.deviceId.size() <= 64
        && d.startedAt is timestamp && d.endedAt is timestamp
        && d.endedAt >= d.startedAt
        && d.endedAt <= request.time + duration.value(1, 'd')
        && d.activeSeconds is int && d.activeSeconds > 0 && d.activeSeconds <= 86400
        // Active time cannot exceed the session window (small clock slack).
        && d.activeSeconds <= wallSeconds + 120
        && d.timezone is string && d.timezone.size() > 0 && d.timezone.size() <= 64
        && d.localDate is string
        && d.localDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.mode == 'reading'
        && (!('lastVerseKey' in d) || d.lastVerseKey == null
            || (d.lastVerseKey is string
                && d.lastVerseKey.matches('^[0-9]{1,3}:[0-9]{1,3}$')))
        && d.syncedAt == request.time;
    }

    function validBookmark(bookmarkId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'surah', 'ayah', 'collection', 'deleted', 'updatedAtMs', 'syncedAt'])
        && d.keys().hasAll([
          'surah', 'ayah', 'collection', 'deleted', 'updatedAtMs', 'syncedAt'])
        && d.surah is int && d.surah >= 1 && d.surah <= 114
        && d.ayah is int && d.ayah >= 1 && d.ayah <= 286
        && bookmarkId == string(d.surah) + '_' + string(d.ayah)
        && d.collection is string
        && d.collection.size() > 0 && d.collection.size() <= 40
        && d.deleted is bool
        && d.updatedAtMs is int && d.updatedAtMs > 0
        && d.syncedAt == request.time;
    }

    match /users/{uid} {
      // Only subcollections are used; the user document itself stays empty.
      allow read, write: if false;

      match /sessions/{sessionId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validSession(sessionId);
      }

      match /bookmarks/{bookmarkId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validBookmark(bookmarkId);
      }
    }
  }
}
