    {
      "id": "a5f89a82-950d-4a3d-84bc-b08a33f4dd98",
      "name": "Hitung keputusan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "jsCode": "\n// Hitung keputusan reviewer untuk materi yang barusan direview.\n// Aturan repo (RELIGIOUS_CONTENT_GOVERNANCE): minimal 2 reviewer menyetujui dan tidak ada penolakan.\nconst materi = $('Formulir review').first().json['ID materi'];\nconst rows = $input.all().map(i => i.json).filter(r => String(r.materi) === String(materi));\nconst setuju = new Set(rows.filter(r => r.keputusan === 'Setuju').map(r => r.reviewer.toLowerCase()));\nconst tolak  = rows.filter(r => r.keputusan === 'Perlu perbaikan');\nreturn [{ json: {\n  materi,\n  jumlah_setuju: setuju.size,\n  jumlah_perbaikan: tolak.length,\n  siap_terbit: setuju.size >= 2 && tolak.length === 0,\n  catatan: tolak.map(r => `- ${r.reviewer}: ${r.catatan}`).join('\\n'),\n}}];\n"
      }
    },
    {
      "id": "20540b01-2d8d-4d55-87a3-e406a933cec7",
      "name": "Siap terbit?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "ae07df98-3721-416e-8d9b-403b5d49d54a",
              "leftValue": "={{ $json.siap_terbit }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "4af51fc8-f426-41ab-a076-998327e61744",
      "name": "Issue: siap terbit",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        1440,
        -100
      ],
      "parameters": {
        "authentication": "accessToken",
        "owner": "ZainulArkaanAlinsi",
        "repository": "Qur-an_App",
        "title": "=Terbitkan materi {{ $json.materi }} ({{ $json.jumlah_setuju }} reviewer setuju)",
        "body": "=Materi **{{ $json.materi }}** sudah disetujui {{ $json.jumlah_setuju }} reviewer tanpa catatan perbaikan.\n\nLangkah: ubah `review.status` menjadi `published`, isi `reviewedBy` & `reviewedAt` dari sheet Review, lalu buat PR. Jangan ubah isi materi di langkah ini.",
        "labels": [
          {
            "label": "konten"
          },
          {
            "label": "siap-terbit"
          }
        ]
      }
    },
    {
