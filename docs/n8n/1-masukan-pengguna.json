    {
      "id": "67093bb1-da0e-49b7-aca4-b05affc4c5de",
      "name": "Rapikan & klasifikasi",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        110
      ],
      "parameters": {
        "jsCode": "\n// Normalisasi masukan dari aplikasi (webhook) atau formulir, lalu klasifikasi dengan aturan kata kunci.\n// Tidak memakai AI: hasilnya bisa dijelaskan dan gratis. Ubah daftar kata sesuai kebutuhan.\nconst RULES = [\n  { kategori: 'bug',        kata: ['error', 'crash', 'keluar sendiri', 'tidak bisa', 'gak bisa', 'nggak bisa', 'force close', 'macet', 'hang', 'lemot', 'bug'] },\n  { kategori: 'konten',     kata: ['ayat salah', 'terjemah', 'tajwid', 'harakat', 'salah ketik', 'typo', 'basmalah', 'warna tajwid', 'qari'] },\n  { kategori: 'audio',      kata: ['audio', 'murottal', 'suara', 'unduh', 'download', 'putar'] },\n  { kategori: 'belajar',    kata: ['belajar', 'pelajaran', 'huruf', 'iqro', 'latihan', 'kuis'] },\n  { kategori: 'hafalan',    kata: ['hafal', 'murajaah', 'muraja', 'ziyadah', 'setoran'] },\n  { kategori: 'tampilan',   kata: ['tampilan', 'ui', 'warna', 'font', 'huruf kecil', 'terpotong', 'gelap', 'dark'] },\n  { kategori: 'permintaan', kata: ['tolong tambah', 'minta', 'semoga ada', 'fitur', 'bisa ditambah', 'request'] },\n];\nconst URGENT = ['ayat salah', 'harakat', 'crash', 'tidak bisa dibuka', 'data hilang', 'bookmark hilang'];\n\nreturn $input.all().map(item => {\n  const b = item.json.body ?? item.json;               // webhook membawa body, formulir tidak\n  const teks = String(b.pesan ?? b['Pesan'] ?? '').trim();\n  const lower = teks.toLowerCase();\n  const hit = RULES.find(r => r.kata.some(k => lower.includes(k)));\n  let kategori = String(b.jenis ?? b['Jenis masukan'] ?? '').toLowerCase() || (hit ? hit.kategori : 'lainnya');\n  if (kategori.startsWith('laporan bug')) kategori = 'bug';\n  if (kategori.startsWith('kesalahan konten')) kategori = 'konten';\n  if (kategori.startsWith('permintaan fitur')) kategori = 'permintaan';\n  const mendesak = URGENT.some(k => lower.includes(k)) || kategori === 'konten';\n  return { json: {\n    id: 'FB-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 6),\n    diterima: new Date().toISOString(),\n    sumber: item.json.body ? 'aplikasi' : 'formulir',\n    kategori,\n    prioritas: mendesak ? 'P1' : (kategori === 'bug' ? 'P2' : 'P3'),\n    pesan: teks.slice(0, 2000),\n    layar: String(b.layar ?? b['Layar/fitur'] ?? ''),\n    rujukan_ayat: String(b.rujukan_ayat ?? b['Rujukan ayat (jika ada)'] ?? ''),\n    versi_app: String(b.versi_app ?? ''),\n    perangkat: String(b.perangkat ?? ''),\n    // email hanya disimpan bila pengguna mencentang izin dihubungi\n    kontak: (b.boleh_dihubungi === true || b['Boleh dihubungi?'] === 'Ya') ? String(b.email ?? b['Email'] ?? '') : '',\n    status: 'baru',\n  }};\n});\n"
      }
    },
