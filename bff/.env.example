# Salin ke .env untuk pengembangan lokal. JANGAN commit .env.
# Kredensial hanya hidup di server/secret manager, tidak pernah di aplikasi.

# Kredensial Developer Console Quran Foundation.
QF_CLIENT_ID=
QF_CLIENT_SECRET=

# Lingkungan API: prestaging (default) atau production.
QF_ENVIRONMENT=prestaging

# Kosongkan untuk memakai URL bawaan sesuai QF_ENVIRONMENT.
QF_TOKEN_URL=
QF_API_BASE_URL=
QF_SCOPE=content

PORT=8787

# Batas permintaan per IP.
RATE_LIMIT_PER_MINUTE=60

# TTL cache (detik). Konten Al-Qur'an praktis statis; daftar qari lebih pendek.
CACHE_TTL_CONTENT_SECONDS=86400
CACHE_TTL_RESOURCES_SECONDS=3600

# Asal yang boleh memanggil, dipisah koma (kosong = tanpa CORS; aplikasi
# mobile tidak membutuhkannya).
ALLOWED_ORIGINS=
